# Convex local development (auto-filled by `npx convex dev` / `npx convex init`)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Vercel production runtime
# Add the production Convex URL in Vercel Project Settings > Environment Variables.
# Example: VITE_CONVEX_URL=https://your-production-deployment.convex.cloud

# Clerk - https://dashboard.clerk.com/last-active?path=api-keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Frontend API URL (same value for Convex JWT validation)
CLERK_FRONTEND_API_URL=https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Google Maps Embed API (enables Street View on property pages)
VITE_GOOGLE_MAPS_API_KEY=

# Convex backend - set with:
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
# npx convex env set ADMIN_EMAILS yammertaurus@gmail.com,manager@example.com
